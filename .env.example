# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PORT: Server port (default 3000)
PORT=3000

# POSTGRESQL DATABASE CONFIGURATION
# Connect to your managed PostgreSQL database (e.g., Supabase, Neon, AWS RDS, Cloud SQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/artisanal_patisserie?sslmode=prefer"

# WHATSAPP BUSINESS PLATFORM (CLOUD API) CONFIGURATION
# Meta for Developers (developers.facebook.com) > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN="YOUR_META_WHATSAPP_SYSTEM_USER_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="YOUR_WHATSAPP_PHONE_NUMBER_ID"
WHATSAPP_BUSINESS_ACCOUNT_ID="YOUR_WHATSAPP_BUSINESS_ACCOUNT_ID"
WHATSAPP_VERIFY_TOKEN="artisanal_patisserie_verify_token_secret"
WHATSAPP_APP_SECRET="YOUR_META_APP_SECRET"
WHATSAPP_API_VERSION="v21.0"

# BUSINESS CONTACT & CLICK-TO-CHAT NUMBERS
# Primary inquiry number
PRIMARY_CONTACT_PHONE="8056702505"
# Secondary inquiry number
SECONDARY_CONTACT_PHONE="7401039450"
# Configured WhatsApp direct click-to-chat international number (e.g. 918056702505 or 15550192834)
WHATSAPP_PHONE_NUMBER="918056702505"

# ADMIN AUTHENTICATION
ADMIN_SECRET_KEY="patisserie_atelier_secret_2026"
